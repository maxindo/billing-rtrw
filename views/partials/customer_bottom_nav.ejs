<!-- views/partials/customer_bottom_nav.ejs -->
<% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
<style>
  .customer-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 72px;
    background: rgba(3, 20, 13, 0.96);
    backdrop-filter: blur(18px) saturate(170%);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    border-top: 1px solid rgba(52, 211, 153, 0.22);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 1050;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -14px 38px rgba(0, 0, 0, 0.42);
  }

  .customer-bottom-nav .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #86bda5;
    text-decoration: none;
    font-size: 10px;
    font-weight: 700;
    transition: color .2s ease, transform .2s ease, background .2s ease;
    flex: 1;
    height: 100%;
    cursor: pointer;
    position: relative;
    border-radius: 14px;
    margin: 4px 2px;
  }

  .customer-bottom-nav .nav-item i {
    font-size: 20px;
    margin-bottom: 3px;
    color: #a7f3d0 !important;
    transition: transform .2s ease, color .2s ease;
  }

  .customer-bottom-nav .nav-item:hover {
    color: #ecfdf5;
    background: rgba(16,185,129,.08);
  }

  .customer-bottom-nav .nav-item.active {
    color: #ecfdf5;
    background: rgba(16,185,129,.12);
  }

  .customer-bottom-nav .nav-item.active i {
    transform: translateY(-2px);
    color: #34d399 !important;
  }

  .customer-bottom-nav .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: 5px;
    width: 18px;
    height: 3px;
    background: linear-gradient(90deg,#10b981,#6ee7b7);
    border-radius: 999px;
    box-shadow: 0 0 10px rgba(52,211,153,.7);
  }

  @media (max-width: 390px) {
    .customer-bottom-nav .nav-item { font-size: 9px; }
    .customer-bottom-nav .nav-item i { font-size: 18px; }
  }

  /* Hide on desktop, show only on mobile */
  @media (min-width: 992px) {
    .customer-bottom-nav {
      display: none;
    }
    body {
      padding-bottom: 0 !important;
    }
  }
</style>

<nav class="customer-bottom-nav" aria-label="Navigasi pelanggan">
  <a href="/customer/dashboard#home-section" class="nav-item <%= activeNav === 'home' ? 'active' : '' %>">
    <i class="bi bi-house-door-fill"></i>
    <span>Beranda</span>
  </a>
  <div class="nav-item" onclick="triggerEditSsidNav()" title="Ubah Nama WiFi" role="button" tabindex="0">
    <i class="bi bi-wifi"></i>
    <span>Nama WiFi</span>
  </div>
  <div class="nav-item" onclick="triggerEditPasswordNav()" title="Ubah Sandi WiFi" role="button" tabindex="0">
    <i class="bi bi-key-fill"></i>
    <span>Sandi WiFi</span>
  </div>
  <a href="/customer/dashboard#billing-section" class="nav-item <%= activeNav === 'billing' ? 'active' : '' %>">
    <i class="bi bi-receipt-cutoff"></i>
    <span>Tagihan</span>
  </a>
  <div class="nav-item" onclick="triggerTicketNav()" title="Bantuan Keluhan" role="button" tabindex="0">
    <i class="bi bi-headset"></i>
    <span>Bantuan</span>
  </div>
</nav>

<script>
  function triggerEditSsidNav() {
    if (typeof editSsid === 'function') {
      const devId = (typeof customer !== 'undefined' && customer && customer.id) ? customer.id : '';
      const ssid = (typeof customer !== 'undefined' && customer && customer.ssid) ? customer.ssid : '';
      editSsid(devId, ssid);
    } else {
      window.location.href = '/customer/dashboard#home-section';
    }
  }

  function triggerEditPasswordNav() {
    if (typeof editPassword === 'function') {
      const devId = (typeof customer !== 'undefined' && customer && customer.id) ? customer.id : '';
      editPassword(devId);
    } else {
      window.location.href = '/customer/dashboard#home-section';
    }
  }

  function triggerTicketNav() {
    const el = document.getElementById('ticketModal');
    if (el && typeof bootstrap !== 'undefined') {
      const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
      m.show();
    } else {
      window.location.href = '/customer/dashboard#ticket-section';
    }
  }

  function updateActiveNav() {
    const hash = window.location.hash;
    document.querySelectorAll('.customer-bottom-nav .nav-item').forEach(item => {
      item.classList.remove('active');
      if (item.getAttribute('href') && item.getAttribute('href').includes(hash) && hash !== '') {
        item.classList.add('active');
      }
    });

    if (hash === '' || hash === '#home-section') {
      const homeNav = document.querySelector('.customer-bottom-nav a[href*="home-section"]');
      if (homeNav) homeNav.classList.add('active');
    }
  }

  document.querySelectorAll('.customer-bottom-nav [role="button"]').forEach(item => {
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        item.click();
      }
    });
  });

  window.addEventListener('hashchange', updateActiveNav);
  window.addEventListener('load', updateActiveNav);
</script>
<% } %>
